# ============================================================================
# PredictOS Express Server — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================================

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3001
# Your Railway public URL (used to register Telegram webhook)
# e.g. https://predictos-server-production.up.railway.app
PUBLIC_URL=https://your-app.railway.app

# ─── AI Providers (add at least one) ─────────────────────────────────────────
# Gemini — FREE tier at https://aistudio.google.com
# Models: gemini-2.0-flash (fast/cheap), gemini-2.5-pro (most capable)
GEMINI_API_KEY=your_gemini_api_key_here

# xAI Grok — https://console.x.ai
XAI_API_KEY=your_xai_api_key_here

# OpenAI — https://platform.openai.com
OPENAI_API_KEY=your_openai_api_key_here

# ─── Market Data APIs ─────────────────────────────────────────────────────────
# Dome API — Polymarket data → https://dashboard.domeapi.io
DOME_API_KEY=your_dome_api_key_here

# DFlow API — Kalshi data → DM @dflow on X
DFLOW_API_KEY=your_dflow_api_key_here

# ─── Telegram Bot ─────────────────────────────────────────────────────────────
# Get from @BotFather on Telegram → /newbot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Chat ID that receives arbitrage alerts
# To get your chat ID: message @userinfobot on Telegram
# For a channel: use @channelusername or the numeric ID (e.g. -1001234567890)
TELEGRAM_ALERT_CHAT_ID=your_chat_id_here

# ─── Arbitrage Scanner Settings ───────────────────────────────────────────────
ARB_MIN_PROFIT_PCT=3          # Minimum profit % to trigger alert (default: 3)
ARB_MIN_VOLUME=10000          # Minimum market volume in USD (default: $10k)
ARB_SCAN_LIMIT=50             # Max markets to scan per platform (default: 50)
ARB_AI_MODEL=gemini-2.0-flash # AI model for market matching

# ─── Polymarket Trading (optional — only for betting bots) ───────────────────
POLYMARKET_WALLET_PRIVATE_KEY=your_private_key_here
POLYMARKET_PROXY_WALLET_ADDRESS=your_proxy_wallet_address_here
